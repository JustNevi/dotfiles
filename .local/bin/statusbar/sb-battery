#!/bin/sh

OUTPUT=""

for BATTERY_PATH in /sys/class/power_supply/BAT*; do
    [ -d "$BATTERY_PATH" ] || continue

    STATUS=$(cat "$BATTERY_PATH/status" 2>/dev/null)
    CAPACITY=$(cat "$BATTERY_PATH/capacity" 2>/dev/null)
    POWER_NOW=$(cat "$BATTERY_PATH/power_now" 2>/dev/null)

    STATUS_ICON="󰢤"
    BATTERY_ICON="󰂌"
      
    battery_status_icon(){
        case $STATUS in
            "Full")
                [ -n "$POWER_NOW" ] && [ "$POWER_NOW" -gt 0 ] && 
                    STATUS_ICON="" || 
                    STATUS_ICON=""                     ;;
            "Charging")          STATUS_ICON=""    ;;
            "Discharging")       STATUS_ICON=""      ;;
            "Not charging")      STATUS_ICON=""     ;;
            "Unknown")           STATUS_ICON="󰢤"     ;;
            *)                   STATUS_ICON="?"     ;;
        esac
    }

    battery_cappacity_icon(){
        case "$CAPACITY" in
            100) BATTERY_ICON="󰁹" ;;
            9[0-9]) BATTERY_ICON="󰂂" ;;
            8[0-9]) BATTERY_ICON="󰂁" ;;
            7[0-9]) BATTERY_ICON="󰂀" ;;
            6[0-9]) BATTERY_ICON="󰁿" ;;
            5[0-9]) BATTERY_ICON="󰁾" ;;
            4[0-9]) BATTERY_ICON="󰁽" ;;
            3[0-9]) BATTERY_ICON="󰁼" ;;
            2[0-9]) BATTERY_ICON="󰁻" ;;
            1[0-9]) BATTERY_ICON="󰁺" ;;
            *) BATTERY_ICON="󰂎" ;;
        esac
    }

    battery_status_icon
    battery_cappacity_icon

    BAT_OUTPUT="$STATUS_ICON$BATTERY_ICON $CAPACITY%"
    
    if [ -z "$OUTPUT" ]; then
        OUTPUT="$BAT_OUTPUT"
    else
        OUTPUT="$OUTPUT $BAT_OUTPUT"
    fi
done

# ===OUTPUT===
echo "$OUTPUT"
