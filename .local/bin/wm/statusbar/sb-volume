#!/bin/sh
AUDIO="@DEFAULT_AUDIO_SINK@"
IS_MUTED=0
VOLUME_ICON=""
VOLUME="x"

volume() {
    VOL=$(wpctl get-volume $AUDIO) 

    IS_MUTED=0
    if [ "$VOL" != "${VOL%\[MUTED\]}" ] ; then
        IS_MUTED=1
    fi

    VOLUME=$(echo $VOL | awk '{print int($2 * 100)}')
}

volume_icon() {
    if [ "$IS_MUTED" -eq 1 ]; then
        VOLUME_ICON=""
        return
    fi

    if [ "$VOLUME" -ge 100 ]; then
        VOLUME_ICON=""
        return
    fi

    case "$VOLUME" in
        [7-9][0-9]) VOLUME_ICON="" ;; # 70-99
        [4-6][0-9]) VOLUME_ICON="" ;; # 40-69
        [1-3][0-9]) VOLUME_ICON="" ;; # 1-39
        *) VOLUME_ICON="" ;;          # 0 or lower
    esac
}

volume
volume_icon

# ===OUTPUT===
echo "$VOLUME_ICON $VOLUME%"
